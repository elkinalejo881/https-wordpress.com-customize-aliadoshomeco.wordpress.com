NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.asisvet.example
AUTH_JWT_SECRET=<mínimo 32 caracteres aleatorios>

# Base de datos principal (SQL Server / Azure SQL)
SQL_SERVER=miservidor.database.windows.net
SQL_DATABASE=asisvet
SQL_USER=app_documentos
SQL_PASSWORD=<secreto>

# Almacenamiento de objetos (privado)
STORAGE_PROVIDER=azure            # azure | local (local solo desarrollo)
AZURE_CONTAINER=documentos
AZURE_STORAGE_ACCOUNT=micuenta    # con Managed Identity no hace falta clave
# AZURE_STORAGE_KEY=              # alternativa a Managed Identity
# AZURE_STORAGE_CONNECTION_STRING=

# Antivirus ClamAV (obligatorio en producción)
CLAMD_HOST=clamav
CLAMD_PORT=3310

# Ajustes (opcionales)
SIGNED_URL_SECONDS=120
MAX_FILES_PER_UPLOAD=20
DOC_LIMITS_MB={"radiograph":150,"patient_photo":10}
DOC_RETENTION_YEARS={"clinical_history_pdf":20}
